+                .setCustomId('pet_play')
+                .setLabel('Play')
+                .setEmoji('🎾')
+                .setStyle(ButtonStyle.Primary), // Blue
+            new ButtonBuilder()
+                .setCustomId('pet_rename')
+                .setLabel('Rename')
+                .setEmoji('🏷️')
+                .setStyle(ButtonStyle.Secondary), // Gray
+            new ButtonBuilder()
+                .setCustomId('pet_unequip')
+                .setLabel('Unequip')
+                .setEmoji('⭐')

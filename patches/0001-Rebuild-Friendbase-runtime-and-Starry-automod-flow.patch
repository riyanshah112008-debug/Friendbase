+
+let User;
+try {
+    User = require('../models/User');
+} catch (e) {
+    User = mongoose.models.User;
+}
+
+// 🛡️ PERMANENT HIGH-SPEED FALLBACK GIF POOLS (VERIFIED DIRECT URLS)
+const FALLBACK_GIFS = {
